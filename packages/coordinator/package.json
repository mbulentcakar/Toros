    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@toros/contracts": "*",
    "@toros/envelope": "*"
  },
  "devDependencies": {
    "@toros/node-core": "*",
    "@toros/store": "*"
  }
}
