{
  "name": "@toros/coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The one-job Hermes coordinator runtime",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
